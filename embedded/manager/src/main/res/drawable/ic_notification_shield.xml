<?xml version="1.0" encoding="utf-8"?>
<!--
  ==========================================================================
  YouLong Security Shield - project-specific resource (not from upstream Stellar)
  ==========================================================================
  Purpose: the small icon used by notifications posted by the embedded manager.

  Upstream used R.drawable.ic_stellar (the Stellar brand icon). This project
  removes every Stellar icon as requested, so notifications now use this file:
  a plain white shield glyph.

  A notification small icon is a MASK: the system only uses its alpha channel
  and tints it. It must therefore be a single-colour shape on a transparent
  background. Using a colourful launcher icon here renders as a white blob.

  ==========================================================================
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,1L3,5v6c0,5.55 3.84,10.74 9,12 5.16,-1.26 9,-6.45 9,-12V5L12,1zM12,11.99h7c-0.53,4.12 -3.28,7.79 -7,8.94V12H5V6.3l7,-3.11v8.8z" />
</vector>

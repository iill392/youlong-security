<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material3 slider attrs (needed by styles) -->
    <attr name="indicatorTrackGapSize" format="dimension" />
    <attr name="trackStopIndicatorSize" format="dimension" />
    <attr name="thumbHeight" format="dimension" />
    <attr name="thumbWidth" format="dimension" />
    <attr name="thumbTrackGapSize" format="dimension" />
    <attr name="trackInsideCornerSize" format="dimension" />
    <attr name="showMarker" format="boolean" />

    <!-- DynamicSpot custom attributes -->
    <attr name="SharedValue" format="integer" />
    <attr name="SharedValueId" format="reference" />

    <!-- AudioVisualizer -->
    <attr name="avColor" format="color" />
    <attr name="avDensity" format="float" />
    <attr name="avGravity" format="string" />
    <attr name="avSpeed" format="string" />
    <attr name="avType" format="string" />
    <attr name="avWidth" format="dimension" />

    <!-- Lottie -->
    <attr name="lottie_autoPlay" format="boolean" />
    <attr name="lottie_colorFilter" format="color" />
    <attr name="lottie_enableMergePathsForKitKatAndAbove" format="boolean" />
    <attr name="lottie_fileName" format="string" />
    <attr name="lottie_imageAssetsFolder" format="string" />
    <attr name="lottie_loop" format="boolean" />
    <attr name="lottie_progress" format="float" />
    <attr name="lottie_rawRes" format="reference" />
    <attr name="lottie_renderMode">
        <enum name="automatic" value="0" />
        <enum name="hardware" value="1" />
        <enum name="software" value="2" />
    </attr>
    <attr name="lottie_repeatCount" format="integer" />
    <attr name="lottie_repeatMode">
        <enum name="restart" value="1" />
        <enum name="reverse" value="2" />
    </attr>
    <attr name="lottie_scale" format="float" />
    <attr name="lottie_speed" format="float" />
    <attr name="lottie_url" format="string" />

    <!-- CircleImageView -->
    <attr name="civ_border" format="boolean" />
    <attr name="civ_border_color" format="color" />
    <attr name="civ_border_color2" format="color" />
    <attr name="civ_border_color2_direction">
        <flag name="left_to_right" value="0x00000001" />
        <flag name="right_to_left" value="0x00000002" />
        <flag name="top_to_bottom" value="0x00000003" />
        <flag name="bottom_to_top" value="0x00000004" />
    </attr>
    <attr name="civ_border_color2_end" format="color" />
    <attr name="civ_border_color2_start" format="color" />
    <attr name="civ_border_overlay" format="boolean" />
    <attr name="civ_border_width" format="dimension" />
    <attr name="civ_border_width2" format="dimension" />
    <attr name="civ_circle_background_color" format="color" />
    <attr name="civ_circle_color" format="color" />
    <attr name="civ_circle_color_direction">
        <flag name="left_to_right" value="0x00000001" />
        <flag name="right_to_left" value="0x00000002" />
        <flag name="top_to_bottom" value="0x00000003" />
        <flag name="bottom_to_top" value="0x00000004" />
    </attr>
    <attr name="civ_circle_color_end" format="color" />
    <attr name="civ_circle_color_start" format="color" />
    <attr name="civ_shadow" format="boolean" />
    <attr name="civ_shadow_color" format="color" />
    <attr name="civ_shadow_gravity">
        <flag name="center" value="0x00000001" />
        <flag name="top" value="0x00000002" />
        <flag name="bottom" value="0x00000003" />
        <flag name="start" value="0x00000004" />
        <flag name="end" value="0x00000005" />
    </attr>
    <attr name="civ_shadow_radius" format="dimension" />

    <!-- ViewPagerIndicator -->
    <attr name="vpi_animation" format="boolean" />
    <attr name="vpi_default_color" format="reference|color" />
    <attr name="vpi_distance" format="reference|dimension" />
    <attr name="vpi_distanceType">
        <enum name="BY_RADIUS" value="0" />
        <enum name="BY_DISTANCE" value="1" />
        <enum name="BY_LAYOUT" value="2" />
    </attr>
    <attr name="vpi_indicatorType">
        <enum name="LINE" value="0" />
        <enum name="CIRCLE" value="1" />
        <enum name="CIRCLE_LINE" value="2" />
        <enum name="BEZIER" value="3" />
        <enum name="SPRING" value="4" />
        <enum name="PROGRESS" value="5" />
    </attr>
    <attr name="vpi_length" format="reference|dimension" />
    <attr name="vpi_num" format="integer" />
    <attr name="vpi_radius" format="reference|dimension" />
    <attr name="vpi_radius_selected" format="reference|dimension" />
    <attr name="vpi_selected_color" format="reference|color" />

    <!-- ColorPicker -->
    <attr name="bar_length" format="dimension" />
    <attr name="bar_orientation_horizontal" format="boolean" />
    <attr name="bar_pointer_halo_radius" format="dimension" />
    <attr name="bar_pointer_radius" format="dimension" />
    <attr name="bar_thickness" format="dimension" />
    <attr name="color_center_halo_radius" format="dimension" />
    <attr name="color_center_radius" format="dimension" />
    <attr name="color_pointer_halo_radius" format="dimension" />
    <attr name="color_pointer_radius" format="dimension" />
    <attr name="color_wheel_radius" format="dimension" />
    <attr name="color_wheel_thickness" format="dimension" />

    <!-- Drag-sort / custom DS -->
    <attr name="click_remove_id" format="integer" />
    <attr name="collapsed_height" format="dimension" />
    <attr name="drag_enabled" format="boolean" />
    <attr name="drag_handle_id" format="integer" />
    <attr name="drag_scroll_start" format="float" />
    <attr name="drag_start_mode">
        <enum name="onDown" value="0" />
        <enum name="onMove" value="1" />
        <enum name="onLongPress" value="2" />
    </attr>
    <attr name="drop_animation_duration" format="integer" />
    <attr name="fling_handle_id" format="integer" />
    <attr name="float_alpha" format="float" />
    <attr name="float_background_color" format="color" />
    <attr name="remove_animation_duration" format="integer" />
    <attr name="remove_enabled" format="boolean" />
    <attr name="remove_mode">
        <enum name="clickRemove" value="0" />
        <enum name="flingRemove" value="1" />
    </attr>
    <attr name="slide_shuffle_speed" format="float" />
    <attr name="sort_enabled" format="boolean" />
    <attr name="track_drag_sort" format="boolean" />
    <attr name="use_default_controller" format="boolean" />
    <attr name="strokeColorPref" format="color" />
    <attr name="strokeWidthPref" format="integer" />
    <attr name="max_drag_scroll_speed" format="float" />

    <!-- ColorPreference -->
    <attr name="dialogTitle" format="string|reference" />
    <attr name="colors" format="reference" />
    <attr name="material" format="boolean" />
    <attr name="backwardsOrder" format="boolean" />
    <attr name="columns" format="integer" />
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!--
  ==========================================================================
  游龙安全护盾 —— 夜间模式下的状态栏/窗口配色（2026-10 新增）
  ==========================================================================
  与 values/colors_window.xml 成对：夜间模式背景变深，状态栏图标必须改成**浅色**
  （app_light_status_bar=false），否则深色图标压在深色背景上同样看不见。

  仍然保持「状态栏不透明」：给状态栏一个与页面一致的实色，
  这样无论系统怎么处理 edge-to-edge，时间与图标都有稳定对比度。
  ==========================================================================
-->
<resources>
    <color name="app_window_bg">#FF1C1C1E</color>
    <bool name="app_light_status_bar">false</bool>
</resources>
